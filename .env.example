# Copy to .env and edit, or set these as environment variables in AWS App Runner / ECS
DATABASE_URL=sqlite:///./remora.db
# For AWS RDS PostgreSQL later, example:
# DATABASE_URL=postgresql://remora:PASSWORD@your-rds-endpoint:5432/remora
UPLOAD_DIR=./uploads
SESSION_SECRET=change-me-to-a-long-random-string
PORT=8000
