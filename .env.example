# Copy to .env and edit, or set these as environment variables in AWS App Runner / ECS
DATABASE_URL=sqlite:///./remora.db
# For AWS RDS PostgreSQL later, example:
# DATABASE_URL=postgresql://remora:PASSWORD@your-rds-endpoint:5432/remora
UPLOAD_DIR=./uploads
SESSION_SECRET=change-me-to-a-long-random-string
PORT=8000

# --- Transactional email (welcome, receipts, account updates, ...) ---
# Every email is always generated and stored in the email_outbox table and
# shown in the user's Account > email history. To also deliver to real
# inboxes, set these three (any SMTP provider; Gmail works with an app
# password, FROM_EMAIL then shows as the sender):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=Viavios <you@example.com>
# SMTP_USE_TLS=1

# Key required to send an app-update email to all users (POST /api/app-updates
# with header X-Admin-Key). Leave unset to disable broadcasts.
# APP_UPDATE_KEY=change-me-too
